# Copy to your host's environment settings (Render: Environment). Never commit real values.
REPORTING_DB_URL=postgresql://reporting_ro.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SESSION_SECRET=<long random string>
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=<10+ characters, letters and numbers>
# Optional: on Render the app uses its onrender.com address automatically. Set this only for a custom domain.
APP_URL=
TIMEZONE=America/New_York
DELIVERY_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Reports <reports@yourcompany.com>
DB_PATH=/var/data/reporting-center.db
