{
  "name": "reporting-center",
  "version": "0.1.0",
  "private": true,
  "description": "Reports on the core Supabase database: ad-hoc and saved reports, scheduled email, external sharing and data audits",
  "main": "server/index.js",
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "demo": "DEMO_MODE=true node --no-warnings server/index.js",
    "dev": "DEMO_MODE=true node --no-warnings --watch server/index.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  }
}
